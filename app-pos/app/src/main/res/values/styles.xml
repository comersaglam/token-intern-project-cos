<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Shared look for the 12 keypad buttons (in-app payment flow). Defining it
      once keeps the layout readable and makes restyling a one-line change.
      layout_columnWeight=1 makes the three columns share the width evenly.
    -->
    <style name="KeypadKey" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

</resources>
