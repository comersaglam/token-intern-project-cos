<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Shared look for the 12 keypad buttons. Defining it once here keeps the
      layout readable and makes restyling a one-line change.
      layout_columnWeight=1 makes the three columns share the width evenly.
    -->
    <style name="KeypadKey" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Mocked payment methods (card, meal card, cash) -->
    <style name="MethodButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- VERESİYE: the one method that hands off to the app-pos app -->
    <style name="MethodButtonPrimary" parent="Widget.Material3.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
