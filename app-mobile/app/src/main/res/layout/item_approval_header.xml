<?xml version="1.0" encoding="utf-8"?>
<!-- Section label above a group of approval cards. Boxed on a filled surface so it
     separates the two roles at a glance instead of blending into the background. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:paddingHorizontal="16dp">

    <TextView
        android:id="@+id/sectionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_section_label"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:textColor="?attr/colorOnSurface"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="Satıcı olarak onaylarınız" />
</FrameLayout>
